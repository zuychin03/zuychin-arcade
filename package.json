{
  "name": "zuychin-arcade",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:client": "pnpm --filter @zuychin-arcade/mobile build",
    "export:client:web": "pnpm --filter @zuychin-arcade/mobile export:web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "validate:client:native": "pnpm --filter @zuychin-arcade/mobile validate:native-config",
    "test:dependencies": "node --test scripts/dependency-compat.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "puppeteer-core": "^25.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "ws@^8.0.0": "8.21.0",
      "socket.io-parser@^4.0.0": "4.2.7",
      "fast-uri@^3.0.0": "3.1.6",
      "find-my-way@^9.0.0": "9.7.0",
      "@xmldom/xmldom@~0.8.0": "0.8.15",
      "@xmldom/xmldom@~0.9.0": "0.9.12",
      "baseline-browser-mapping@^2.0.0": "2.11.0",
      "brace-expansion@^5.0.0": "5.0.9",
      "browserslist@^4.0.0": "4.28.7",
      "nanoid@^3.0.0": "3.3.18",
      "postcss@^8.0.0": "8.5.23",
      "postcss-selector-parser@^6.0.0": "6.1.3",
      "shell-quote@^1.0.0": "1.9.0",
      "metro@0.84.4>image-size": "2.0.3",
      "query-string@7.1.3>decode-uri-component": "0.5.0",
      "xcode@3.0.1>uuid": "11.1.1",
      "esbuild@>=0.27.0 <0.29.0": "0.28.1"
    },
    "patchedDependencies": {
      "@expo/metro-file-map@56.0.4": "patches/@expo__metro-file-map@56.0.4.patch",
      "metro@0.84.4": "patches/metro@0.84.4.patch",
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
