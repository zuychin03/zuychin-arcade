PORT=3001
# generate with: openssl rand -base64 32
JWT_SECRET=
# Exact comma-separated web origins. Native clients send no browser Origin.
ARCADE_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# For LAN-hosted Expo web, add its exact origin, for example http://192.168.1.20:8081.
# Explicit fallback for development on this computer only. Forces a loopback bind.
# ARCADE_INSECURE_LOCAL_DEV=true
# Trust only verified proxy IPs or CIDRs. Leave unset without a trusted proxy.
# Documentation-only example; replace with the actual proxy addresses.
# ARCADE_TRUST_PROXY_CIDRS=192.0.2.0/24,2001:db8::/32
# optional - game results are skipped when unset
# Optional example: https://your-project.supabase.co
SUPABASE_URL=
# Backend only. Never expose this key in the Expo bundle.
SUPABASE_SECRET_KEY=
