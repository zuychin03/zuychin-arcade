{
  "name": "@zuychin-arcade/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx --test src/utils/securityConfig.test.ts src/socket/room-security.test.ts",
    "test:results": "tsx src/lib/saveGameResult.test.ts",
    "test:leaderboard": "tsx src/routes/leaderboard.test.ts",
    "test:saboteur": "tsx src/game/saboteur/socketHandlers.test.ts",
    "test:bang": "tsx src/game/bang/socketHandlers.test.ts",
    "test:coup": "tsx src/game/coup/socketHandlers.test.ts",
    "test:king-of-tokyo": "tsx src/game/king-of-tokyo/socketHandlers.test.ts",
    "test:skull-king": "tsx src/game/skull-king/socketHandlers.test.ts",
    "test:citadels": "tsx src/game/citadels/socketHandlers.test.ts",
    "test:not-alone": "tsx src/game/not-alone/socketHandlers.test.ts",
    "test:not-alone:policy": "tsx --test scripts/not-alone/forfeit-policy.test.ts",
    "test:libertalia": "tsx src/game/libertalia/socketHandlers.test.ts",
    "test:libertalia:engine": "tsx --test scripts/libertalia/astra-regressions.test.ts",
    "simulate:saboteur": "tsx scripts/saboteur/simulate.ts",
    "simulate:coup": "tsx scripts/coup/simulate.ts",
    "simulate:king-of-tokyo": "tsx scripts/king-of-tokyo/simulate.ts",
    "simulate:skull-king": "tsx scripts/skull-king/simulate.ts",
    "simulate:citadels": "tsx scripts/citadels/simulate.ts",
    "simulate:not-alone": "tsx scripts/not-alone/simulate.ts",
    "simulate:bang": "tsx scripts/bang/simulate.ts",
    "simulate:libertalia": "tsx scripts/libertalia/simulate.ts",
    "simulate:colt-express": "tsx scripts/colt-express/simulate.ts",
    "smoke:saboteur": "tsx scripts/saboteur/smoke.ts",
    "smoke:coup": "tsx scripts/coup/smoke.ts",
    "smoke:king-of-tokyo": "tsx scripts/king-of-tokyo/smoke.ts",
    "smoke:skull-king": "tsx scripts/skull-king/smoke.ts",
    "smoke:citadels": "tsx scripts/citadels/smoke.ts",
    "smoke:bang": "tsx scripts/bang/smoke.ts",
    "smoke:libertalia": "tsx scripts/libertalia/smoke.ts",
    "smoke:colt-express": "tsx scripts/colt-express/smoke.ts",
    "smoke:not-alone": "tsx scripts/not-alone/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@supabase/supabase-js": "^2.47.0",
    "@zuychin-arcade/types": "workspace:*",
    "fastify": "^5.12.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
