{
  "name": "@zuychin-arcade/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/dom-webview": "~56.0.6",
    "@expo/metro-runtime": "~56.0.21",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@zuychin-arcade/types": "workspace:^",
    "expo": "~56.0.22",
    "expo-blur": "~56.0.4",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.26",
    "expo-font": "~56.0.7",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.18",
    "expo-router": "~56.2.21",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "jwt-decode": "^4.0.0",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "^0.2.5",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.85.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^56.0.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "pnpm run export:web",
    "eas-build-pre-install": "node scripts/validate-env.cjs --production",
    "export:web": "pnpm run validate:env:production && expo export --clear --platform web && node scripts/validate-export-env.cjs dist",
    "export:native": "pnpm run validate:env:production && expo export --clear --platform android --output-dir .expo-export-android && node scripts/validate-export-env.cjs .expo-export-android && expo export --clear --platform ios --output-dir .expo-export-ios && node scripts/validate-export-env.cjs .expo-export-ios",
    "lint": "expo lint",
    "smoke:saboteur-ui": "node scripts/saboteur-ui-smoke.cjs",
    "smoke:coup-ui": "node scripts/coup-ui-smoke.cjs",
    "smoke:king-of-tokyo-ui": "node scripts/king-of-tokyo-ui-smoke.cjs",
    "smoke:citadels-ui": "node scripts/citadels-ui-smoke.cjs",
    "smoke:not-alone-ui": "node scripts/not-alone-ui-smoke.cjs",
    "smoke:libertalia-ui": "node scripts/libertalia-ui-smoke.cjs",
    "typecheck": "tsc --noEmit",
    "validate:env": "node scripts/validate-env.cjs",
    "validate:env:production": "node scripts/validate-env.cjs --production",
    "validate:native-config": "pnpm run validate:env:production && expo config --type introspect"
  },
  "private": true
}
